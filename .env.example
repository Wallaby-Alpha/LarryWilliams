# =================================================================
# MEXC Williams %R Scanner & Telegram Bot Configuration
# =================================================================
#
# HOW TO GET YOUR TELEGRAM CREDENTIALS:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot, give it a name and username (e.g. MyMexcAlertsBot)
# 3. Copy the HTTP API token provided and paste below as TELEGRAM_BOT_TOKEN
# 4. Start a chat with your new bot and click /start
# 5. Search for @userinfobot on Telegram, click /start
# 6. Copy your numeric Id and paste below as TELEGRAM_CHAT_ID
# =================================================================

TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ_1234567
TELEGRAM_CHAT_ID=123456789

# Portfolio Account Size for position sizing calculations in alert messages ($)
ACCOUNT_EQUITY=10000.0

# Risk per trade percentage (default: 0.005 = 0.5% risk)
RISK_PER_TRADE_PCT=0.005

# Scan loop interval in seconds (default: 3600 = 1 hour)
SCAN_INTERVAL_SEC=3600

# Minimum 24h quote volume filter ($)
MIN_24H_QUOTE_VOLUME=5000000.0
